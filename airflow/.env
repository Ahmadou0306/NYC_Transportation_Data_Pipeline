# Airflow Configuration
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=apache/airflow:3.1.6
AIRFLOW_PROJ_DIR=.

# Admin credentials
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Additional packages
_PIP_ADDITIONAL_REQUIREMENTS=google-cloud-storage google-cloud-bigquery apache-airflow-providers-google

# GCP Configuration
GOOGLE_APPLICATION_CREDENTIALS=/opt/airflow/config/gcp/airflow-gcp-key.json
GCP_PROJECT_ID=Training-GCP
GCS_BUCKET_NAME=an-nyc-transport-data-raw

BIGQUERY_SILVER_ID=silver_nyc_transport_pipeline
BIGQUERY_GOLD_ID=gold_nyc_transport_pipeline


